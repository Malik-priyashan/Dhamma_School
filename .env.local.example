# Example environment variables for local development

# Cloudinary (for unsigned client uploads)
# Sign in to Cloudinary, create an unsigned upload preset, and set the cloud name below
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Backend URL for local development
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Optional: enables the Google Maps Embed API in the site footer.
# Restrict this browser-visible key to your website and the Maps Embed API.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your_restricted_maps_embed_api_key

# Google reCAPTCHA v3 (set BOTH values to turn on protection and show the badge).
# Use a separate localhost key pair for local development.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_public_site_key
# RECAPTCHA_SECRET_KEY=your_server_only_secret_key

# Set this on the frontend Vercel project (Production) so API proxy requests
# reach the deployed backend. Leave it unset for local development.
# PROXY_TARGET_BACKEND_URL=https://dhamma-school-be.vercel.app

# Optional (server-only) Cloudinary credentials - DO NOT expose these on the client
# CLOUDINARY_API_KEY=your_api_key_here
# CLOUDINARY_API_SECRET=your_api_secret_here

# Notes:
# - Copy this file to .env.local and replace the placeholder values with real ones.
# - Restart the dev server after updating env vars.
# - Keep real secrets out of version control.
